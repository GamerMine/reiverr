{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["$app/types", "node"],
    "typeRoots": ["node_modules/@types"],
    "module": "ES2022",
    "lib": ["es2022"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false
  },
  "include": ["src", "vite.config.ts", "tests"]
}
