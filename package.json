{
  "name": "unifarr",
  "version": "1.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GamerMine/reiverr"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build:shared": "npm run build -w @unifarr/logging && npm run build -w @unifarr/db && npm run build -w @unifarr/connectors",
    "build": "npm run build:shared && vite build",
    "test": "vitest",
    "lint": "prettier --check . \"!cache/**\"",
    "format": "prettier --write . \"!cache/**\""
  },
  "engines": {
    "node": ">= 20.19"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/load-config": "0.2.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "svelte-language-server": "0.18.6",
    "svelte-loading-spinners": "0.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/fira-mono": "5.3.0",
    "classnames": "2.5.1",
    "cron-parser": "5.10.3",
    "hls.js": "1.7.4",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "svelte-i18n": "4.0.1",
    "svelte-radix": "3.0.2",
    "valibot": "1.5.0"
  },
  "workspaces": [
    "src/shared/logging",
    "src/shared/db",
    "src/shared/connectors"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.19.12": true
  }
}
