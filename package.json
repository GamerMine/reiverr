{
  "name": "reiverr",
  "version": "1.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GamerMine/reiverr"
  },
  "scripts": {
    "dev": "vite dev --host",
    "build:shared": "npm run build -w @reiverr/logging && npm run build -w @reiverr/db && npm run build -w @reiverr/connectors",
    "build": "npm run build:shared && vite build"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.6",
    "@sveltejs/kit": "2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.2.7",
    "classnames": "^2.5.1",
    "cron-parser": "^5.6.0",
    "hls.js": "^1.6.16",
    "openapi-fetch": "^0.17.0",
    "svelte-i18n": "^4.0.1",
    "svelte-radix": "^3.0.2",
    "valibot": "^1.4.1"
  },
  "workspaces": [
    "src/shared/logging",
    "src/shared/db",
    "src/shared/connectors"
  ]
}
