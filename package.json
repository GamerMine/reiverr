		"@sveltejs/kit": "2.52.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/postcss": "^4.1.18",
		"classnames": "^2.5.1",
		"eslint": "9.39.2",
		"eslint-plugin-svelte": "^3.15.0",
		"svelte": "^5.51.2",
		"svelte-check": "^4.4.0",
		"svelte-i18n": "^4.0.1",
		"svelte-radix": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"dependencies": {
