  "type": "module",
  "dependencies": {
    "@jellyfin/sdk": "^0.11.0",
    "@types/node": "^25.8.0",
    "better-sqlite3": "^12.10.0",
    "hls.js": "^1.6.16",
    "openapi-fetch": "^0.17.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "0.3.29"
  }
